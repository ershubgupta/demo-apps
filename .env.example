# Runtime mode.
# Options: development, test, production.
NODE_ENV=development

# Backend services.
# AUTH_API_URL: base URL for the auth service. Used by /api/auth/[...path].
AUTH_API_URL=http://localhost:4001

# AUTH_API_PATH_PREFIX: auth route prefix on AUTH_API_URL.
# Common options: /api/auth for Better Auth style services, /rest/api/auth for REST auth services.
AUTH_API_PATH_PREFIX=/api/auth

# CATALOG_API_URL: base URL for the catalog backend REST API.
# Server actions append paths like /catalog-ho/ to this value.
CATALOG_API_URL=http://localhost:4010/rest/api

# USE_MOCK_API: use local feature mocks while backend APIs are still in development.
# Options: true, false.
# true: catalog service returns data from src/features/catalog/api/catalog-mock.ts.
# false: catalog service calls CATALOG_API_URL through the auth request helper.
USE_MOCK_API=true

# Auth/session.
# BETTER_AUTH_COOKIE_PREFIX: session cookie prefix used by the auth service.
# Common options: local, dev, qa, prod.
BETTER_AUTH_COOKIE_PREFIX=local

# DEV_BYPASS_AUTH: local-only bypass for page auth and backend auth headers.
# Options: true, false.
# true: skips page auth in development and injects x-user-* headers.
# false: requires a valid auth session cookie.
DEV_BYPASS_AUTH=true

# DEV_KONG_BEARER_TOKEN: optional bearer token for local DEV_BYPASS_AUTH=true API calls.
# Use when your catalog backend is behind Kong/gateway and expects Authorization: Bearer <token>.
# Leave empty for localhost/dev backends that accept x-user-id, x-user-email, and x-user-role headers.
DEV_KONG_BEARER_TOKEN=

# SSO and password login configuration.
# ENABLE_PASSWORD_LOGIN: show/support email-password login.
# Options: true, false.
ENABLE_PASSWORD_LOGIN=true

# ENABLE_SSO_LOGIN: show/support SSO login.
# Options: true, false.
ENABLE_SSO_LOGIN=true

# SSO_PROVIDER: provider id expected by the auth service.
# Common options: microsoft, azure-ad, google. Use the backend-configured provider id.
SSO_PROVIDER=microsoft

# SSO_CALLBACK_URL: callback URL registered with the SSO provider/auth service.
SSO_CALLBACK_URL=http://localhost:3010/api/auth/callback/microsoft

# Optional service metadata.
# NEXT_PUBLIC_APP_NAME: browser-safe app display name.
NEXT_PUBLIC_APP_NAME=Catalog Admin
